<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="64dp"
        android:paddingEnd="64dp"
        android:paddingTop="36dp"
        android:paddingBottom="32dp">

        <!-- minimal top bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="36dp">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- wifi: icon + fixed-width scrolling SSID -->
            <LinearLayout
                android:id="@+id/wifiGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_marginEnd="4dp">

                <ImageView
                    android:id="@+id/wifiIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_wifi"
                    android:alpha="0.7" />

                <TextView
                    android:id="@+id/ssid"
                    android:layout_width="wrap_content"
                    android:maxWidth="110dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/text_dim"
                    android:textSize="13sp"
                    android:singleLine="true"
                    android:ellipsize="marquee"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:focusable="true"
                    android:scrollHorizontally="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/weather"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_dim"
                android:textSize="14sp"
                android:layout_marginEnd="18dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:focusable="true"
                android:clickable="true"
                android:visibility="gone" />

            <TextView
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_dim"
                android:textSize="14sp"
                android:layout_marginEnd="18dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:focusable="true"
                android:clickable="true" />

            <TextClock
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm:ss a"
                android:format24Hour="H:mm:ss"
                android:textColor="@color/text_dim"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/settingsBtn"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_settings"
                android:padding="5dp"
                android:layout_marginStart="14dp"
                android:focusable="true"
                android:clickable="true"
                android:contentDescription="Settings" />
        </LinearLayout>

        <!-- app grid -->
        <GridView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:numColumns="6"
            android:horizontalSpacing="18dp"
            android:verticalSpacing="18dp"
            android:layout_marginTop="28dp"
            android:stretchMode="columnWidth"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:listSelector="@android:color/transparent" />

        <!-- move-mode hint bar -->
        <TextView
            android:id="@+id/hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/text_dim"
            android:textSize="13sp"
            android:alpha="0"
            android:layout_marginTop="14dp" />
    </LinearLayout>

    <!-- ground strip with rocks & grass -->
    <dev.hyper.launcher.GroundView
        android:id="@+id/ground"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom" />

    <!-- the little blob companion -->
    <dev.hyper.launcher.BuddyView
        android:id="@+id/buddy"
        android:layout_width="110dp"
        android:layout_height="120dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="30dp" />
</FrameLayout>
