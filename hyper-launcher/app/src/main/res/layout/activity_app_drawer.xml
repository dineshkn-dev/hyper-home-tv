<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="40dp"
    android:paddingEnd="40dp"
    android:paddingTop="28dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/drawerBrand"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="11dp"
            android:src="@drawable/ic_bolt_logo"
            android:focusable="true"
            android:clickable="true"
            android:contentDescription="Launcher settings"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:letterSpacing="0.22"
            android:text="HYPER OS"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/drawerInstalled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.14"
            android:text="0 INSTALLED"
            android:textColor="@color/text_faint"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:letterSpacing="0.08"
            android:text="HOLD OK  ·  OPTIONS"
            android:textColor="@color/text_faint"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/drawerManage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:focusable="true"
            android:clickable="true">

            <ImageView
                android:id="@+id/drawerManageIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_settings"
                android:tint="@color/text_dim"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/drawerManageLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:letterSpacing="0.04"
                android:text="Manage Apps"
                android:textColor="@color/text_dim"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="18dp"
        android:background="@color/line" />

    <dev.hyper.launcher.TvGridView
        android:id="@+id/drawerGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:numColumns="6"
        android:horizontalSpacing="20dp"
        android:verticalSpacing="24dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:stretchMode="columnWidth"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:listSelector="@android:color/transparent" />

</LinearLayout>
