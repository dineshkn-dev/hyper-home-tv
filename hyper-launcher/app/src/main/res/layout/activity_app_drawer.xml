<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="64dp"
    android:paddingEnd="64dp"
    android:paddingTop="24dp"
    android:paddingBottom="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/drawerBrand"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:padding="13dp"
            android:src="@drawable/ic_bolt_logo"
            android:focusable="true"
            android:clickable="true"
            android:contentDescription="Launcher settings"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:letterSpacing="0.22"
            android:text="HYPER OS"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="14dp"
        android:background="@color/line" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/drawerRail"
            android:layout_width="180dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:clipChildren="false">

            <LinearLayout
                android:id="@+id/drawerRailItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipChildren="false" />

            <View
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/drawerInstalled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:letterSpacing="0.16"
                android:text="0 INSTALLED"
                android:textColor="@color/text_faint"
                android:textSize="9.5sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="8dp"
                android:letterSpacing="0.10"
                android:text="HOLD OK · OPTIONS"
                android:textColor="@color/text_faint"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="24dp"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false">

            <TextView
                android:id="@+id/drawerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All Apps"
                android:textColor="@color/text_primary"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/drawerSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="0 apps · 0 pinned"
                android:textColor="@color/text_dim"
                android:textSize="12.5sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="10dp"
                android:background="@color/line" />

            <dev.hyper.launcher.TvGridView
                android:id="@+id/drawerGrid"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:numColumns="6"
                android:horizontalSpacing="16dp"
                android:verticalSpacing="16dp"
                android:stretchMode="columnWidth"
                android:scrollbars="none"
                android:overScrollMode="never"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:listSelector="@android:color/transparent" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
