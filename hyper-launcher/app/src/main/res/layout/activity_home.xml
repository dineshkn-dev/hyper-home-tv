<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="64dp"
    android:paddingEnd="64dp"
    android:paddingTop="24dp"
    android:paddingBottom="18dp">

    <!-- top bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/brandBtn"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:padding="13dp"
                android:src="@drawable/ic_bolt_logo"
                android:focusable="true"
                android:clickable="true"
                android:contentDescription="Launcher settings"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:letterSpacing="0.22"
                android:text="HYPER OS"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextClock
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:format12Hour="h:mm a"
                android:format24Hour="h:mm a"
                android:textAllCaps="true"
                android:textColor="@color/text_primary"
                android:textSize="32sp" />

            <TextView
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:letterSpacing="0.18"
                android:textColor="@color/text_dim"
                android:textSize="10.5sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical|end">

            <ImageView
                android:id="@+id/searchBtn"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:padding="12dp"
                android:src="@drawable/ic_search"
                android:focusable="true"
                android:clickable="true"
                android:contentDescription="Search apps" />

            <ImageView
                android:id="@+id/wifiBtn"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="2dp"
                android:padding="13dp"
                android:src="@drawable/ic_wifi"
                android:focusable="true"
                android:clickable="true"
                android:contentDescription="Wi-Fi" />

            <ImageView
                android:id="@+id/settingsBtn"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="2dp"
                android:padding="13dp"
                android:src="@drawable/ic_settings"
                android:focusable="true"
                android:clickable="true"
                android:contentDescription="System settings" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="18dp"
        android:background="@color/line" />

    <!-- full-width featured deck -->
    <dev.hyper.launcher.FeatureStackView
        android:id="@+id/heroStack"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false" />

    <!-- apps, full width below the deck -->
    <LinearLayout
        android:id="@+id/appsSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="10dp"
            android:background="@color/line" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.18"
                android:text="YOUR APPS"
                android:textColor="@color/text_dim"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/manageAppsLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="VIEW ALL APPS  ›"
                android:textColor="@color/text_dim"
                android:textSize="10sp"
                android:focusable="true"
                android:clickable="true" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pinnedGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:clipToPadding="false" />
    </LinearLayout>
</LinearLayout>
