<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- INTERNET is used only to load Watch Next artwork. No analytics, no ads. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets us trigger the system uninstall confirmation for user apps -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Read connectivity state for the network UI -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Needed by Android 12+ to read the SSID and scan networks in Settings -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Lets the Optimize button sweep cached background apps (normal permission) -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- Opt-in featured deck reads the system Play Next queue -->
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />
    <!-- Lets the Optimize sweep enumerate ALL packages — most cached memory is
         held by packages with no launcher entry (services, providers, GMS) -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.faketouch" android:required="false" />

    <!-- Android 11+ package visibility: a launcher must declare which apps it can see -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:theme="@style/Theme.Hyper"
        android:allowBackup="false"
        android:largeHeap="true"
        android:supportsRtl="true">

        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LauncherSettingsActivity"
            android:exported="false" />

        <activity
            android:name=".AppDrawerActivity"
            android:exported="false" />

        <activity
            android:name=".ManageAppsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
